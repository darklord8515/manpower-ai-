# Template for the repo-root .env (git-ignored). Run `make env` to create .env with random secrets,
# or copy this file to .env and fill it in. Never commit real values.
# (Named env.example, without the leading dot, because .claude/settings.json denies reads of .env.*)

# --- Environment ------------------------------------------------------------
# local | test | demo | production. Production refuses to start on any demo-only setting.
APP_ENV=local
DEMO_MODE=true
SIMULATED_CLOCK=false

# --- Postgres (local Docker) -------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
N8N_DB_PASSWORD=
# The API connects as constructiq_app. Behind Neon's pooled URL set DATABASE_POOLED=true.
DATABASE_URL=postgresql+psycopg://constructiq_app:CHANGE-ME@localhost:5432/constructiq
DATABASE_URL_DIRECT=
DATABASE_POOLED=false

# --- n8n ---------------------------------------------------------------------
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
# Set once, never change: it encrypts credentials stored in n8n.
N8N_ENCRYPTION_KEY=
# Signs webhooks in both directions (API <-> n8n, GitHub Actions -> n8n).
N8N_HMAC_SECRET=

# --- API ---------------------------------------------------------------------
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
# Password of the seeded demo accounts (HR Manager, HR Executive, MD/CEO). Local and demo only;
# the API refuses to start in production while this is set.
DEMO_PASSWORD=

# --- Storage -----------------------------------------------------------------
# local = development only. s3 = any S3-compatible bucket (Cloudflare R2 in the demo).
STORAGE_BACKEND=local

# --- LLM tiers (provider + model per tier; agents never name a model) -------
# A tier with no model is OFF: the alert narrator then keeps the template wording and the AI
# buttons are disabled.
#
# Named providers (preferred). Put each provider's key once, then name a primary and a fallback
# per tier as provider:model. The fallback answers when the primary is rate-limited, down, or
# refuses the key. Providers: groq, openrouter, huggingface, ollama (no key), anthropic.
#   GROQ_API_KEY         https://console.groq.com/keys
#   OPENROUTER_API_KEY   https://openrouter.ai/keys   (":free" models are free; others cost credits)
#   HF_TOKEN             https://huggingface.co/settings/tokens   (optional third provider)
# Run `make ai-check` to see which models can route, return JSON and call tools, and to get the
# four lines below filled in for you. Then try the narrator with `make ai-smoke`.
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
LLM_TIER_LIGHT_PRIMARY=
LLM_TIER_LIGHT_FALLBACK=
LLM_TIER_MID_PRIMARY=
LLM_TIER_MID_FALLBACK=
# Providers on a paid plan, comma-separated (production refuses free-tier models), e.g. groq
LLM_PAID_PROVIDERS=
#
# Older single-provider lines (ignored for a tier once its PRIMARY is set):
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1      (no key needed)
# For provider=anthropic leave the base URL empty (it defaults to https://api.anthropic.com).
# *_FREE=true is refused in production.
LLM_TIER_LIGHT_PROVIDER=openai_compatible
LLM_TIER_LIGHT_MODEL=
LLM_TIER_LIGHT_BASE_URL=
LLM_TIER_LIGHT_API_KEY=
LLM_TIER_LIGHT_FREE=true
LLM_TIER_MID_PROVIDER=openai_compatible
LLM_TIER_MID_MODEL=
LLM_TIER_MID_BASE_URL=
LLM_TIER_MID_API_KEY=
LLM_TIER_MID_FREE=true

# --- Business config ---------------------------------------------------------
DOC_CHECK_DEFAULT_HORIZON_DAYS=90
TRANSFER_BUFFER_DAYS=7
FORECAST_DOC_HORIZON_DAYS=90
FORECAST_WINDOW_DAYS=120
APPROVAL_WAIT_HOURS=24

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
